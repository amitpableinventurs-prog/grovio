# Single-page app on Apache/LiteSpeed (Hostinger): serve index.html for any path that isn't a real
# file or folder, so refreshing or opening a link like /orders/123 loads the app instead of a 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
