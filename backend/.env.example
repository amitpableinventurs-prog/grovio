NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/grovio

# JWT access token (short-lived) + refresh token (long-lived, stored hashed in DB)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_DAYS=30

# Default admin (created by seed script)
DEFAULT_ADMIN_NAME=Grovio Admin
DEFAULT_ADMIN_EMAIL=admin@grovio.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# OTP (dev mode: OTP is returned in the API response + logged to console)
OTP_EXPIRY_MINUTES=5
OTP_DEBUG_MODE=true
# Leave blank in production. Set to always issue this exact OTP (e.g. "1234")
# so you never have to read debugOtp out of the response while testing.
OTP_FIXED_CODE=1234
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5

# Razorpay (test-mode keys — get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Delivery / commission defaults (also editable via admin Settings API)
DEFAULT_DELIVERY_FEE=25
DEFAULT_COMMISSION_PERCENT=10
