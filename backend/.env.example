NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/grovio

# JWT access token (short-lived) + refresh token (long-lived, stored hashed in DB)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_DAYS=30

# Default admin (created by seed script)
DEFAULT_ADMIN_NAME=Grovio Admin
DEFAULT_ADMIN_EMAIL=admin@grovio.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# OTP (dev mode: OTP is returned in the API response + logged to console)
OTP_EXPIRY_MINUTES=5
OTP_DEBUG_MODE=true
# Leave blank in production. Set to always issue this exact OTP (e.g. "1234")
# so you never have to read debugOtp out of the response while testing.
OTP_FIXED_CODE=1234
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5

# Razorpay (test-mode keys — get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Delivery / commission defaults (also editable via admin Settings API)
DEFAULT_DELIVERY_FEE=25
DEFAULT_COMMISSION_PERCENT=10

# Hub Center screens (/hub-display) and Delivery Boy hub check-in
# Public origin used in screen pairing links and the check-in QR (defaults to the request's host).
PUBLIC_BASE_URL=
HUB_CHECKIN_MINUTES=30
# Where customers return after paying with PayU / PhonePe (also settable in Admin > Settings)
CUSTOMER_WEB_URL=http://localhost:5174

# Live tracking — all also editable in Admin > Settings > Tracking & Delivery Area
TRACKING_AVG_SPEED_KMPH=20
TRACKING_PICKING_MINUTES=10
# Blank = no delivery radius limit (per-store radius is set on the Stores page)
DEFAULT_SERVICE_RADIUS_KM=
GEOFENCE_NEARBY_KM=1
GEOFENCE_PICKUP_METERS=100
GEOFENCE_DROP_METERS=100

# IVR (Exotel) — normally set in Admin > Settings > IVR. IVR_PROVIDER=none records calls as simulated.
IVR_PROVIDER=none
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_MESSAGE_APP_ID=
EXOTEL_CONFIRM_APP_ID=
# Comma list: accepted,out_for_delivery,delivery_failed,delivered,cancelled,rider_nearby,rider_arrived (none = off)
IVR_AUTO_CALL_EVENTS=out_for_delivery,delivery_failed,rider_arrived
# Blank = no COD confirmation calls, 0 = every COD order, N = COD orders of Rs N or more
IVR_COD_CONFIRM_ABOVE=
IVR_MISSED_CALL_CALLBACK=true

# PayU (normally set in Admin > Settings > Payments)
PAYU_KEY=
PAYU_SALT=
PAYU_MODE=test

# PhonePe PG Standard Checkout v2 (normally set in Admin > Settings > Payments)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Dashboard: days and hours are counted in this timezone
DASHBOARD_TZ=Asia/Kolkata
